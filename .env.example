# Chave de API do Google Gemini / Antigravity Interactions API
# Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY=

# (Opcional) Caminho customizado para o banco SQLite local (padrão: antigravity_studio.db)
# ANTIGRAVITY_DB_PATH=antigravity_studio.db

# (Opcional) Limite máximo de requisições por minuto (RPM) enviadas pelo cliente.
# Padrão: 4 (margem segura abaixo de 5 RPM no nível gratuito; use 0 para desativar).
# ANTIGRAVITY_MAX_RPM=4

# (Opcional) Limite máximo de tokens por minuto (TPM) estimados/registrados pelo cliente.
# Padrão: 80000 (margem segura abaixo de 100K TPM do Antigravity no nível gratuito; use 0 para desativar).
# ANTIGRAVITY_MAX_TPM=80000


